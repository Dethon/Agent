@inherits StoreSubscriberComponent
@inject ConnectionStore ConnectionStore

<span class="status-dot @(_isConnected ? "connected" : "")"
      role="status"
      aria-label="@(_isConnected ? "Connected" : "Disconnected")"
      title="@(_isConnected ? "Connected" : "Disconnected")"></span>

@code {
    private bool _isConnected;

    protected override void OnInitialized()
    {
        Subscribe(
            ConnectionStore.StateObservable,
            state => state.Status == ConnectionStatus.Connected,
            isConnected => _isConnected = isConnected);
    }
}