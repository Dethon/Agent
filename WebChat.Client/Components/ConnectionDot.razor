@using WebChat.Client.Contracts
@implements IDisposable
@inject IChatLiveConnection LiveConnection

<span class="status-dot @(LiveConnection.IsConnected ? "connected" : "")"
      role="status"
      aria-label="@(LiveConnection.IsConnected ? "Connected" : "Disconnected")"
      title="@(LiveConnection.IsConnected ? "Connected" : "Disconnected")"></span>

@code {
    protected override void OnInitialized()
    {
        LiveConnection.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LiveConnection.OnStateChanged -= StateHasChanged;
    }
}